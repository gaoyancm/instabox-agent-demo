# Copy to .env and fill in locally. Never commit real values.
# Every cloud, mail and AI action is OFF unless its *_APPROVED flag is exactly "true".

# InstaBox cloud machine (only needed for the cloud controller)
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
CLOUD_EXECUTION_APPROVED=false
EXCLUSIVE_MACHINE_APPROVED=false
RUNTIME_OBSERVATION_APPROVED=false

# Bilingual email notifications (optional)
MAIL_APPROVED=false
MAIL_MODE=observe          # observe | summary
MAIL_EVENTS=FINAL_REPORT
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Optional LLM extraction (OpenAI-compatible chat completions endpoint)
AI_NETWORK_APPROVED=false
MODEL_NAME=
MODEL_ENDPOINT=
MODEL_API_KEY=

# Public-only website research: crawl only explicitly authorized domains
PUBLIC_RESEARCH_DOMAIN=example.com
PUBLIC_RESEARCH_DOMAINS=example.com

# Local browser tests
CHROMIUM_PATH=
